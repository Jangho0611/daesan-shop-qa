ze: 20px; font-weight: 800; color: #222; margin: 0 0 18px;\r\n\t}\r\n\t\r\n\t.block {\r\n\t\tmax-width: 645px; padding: 20px 0;\r\n\t}\r\n\t\r\n\t.option {\r\n\t\tmargin-top: 18px; border-top: 1px solid #666; border-bottom: 1px solid #e0e0e0;\r\n\t}\r\n\t\r\n\t.option h6,\r\n\t.textBox h6 {\r\n\t\tfont-size: 16px; font-weight: 700; margin: 0 0 14px; color: #222;\r\n\t}\r\n\t\r\n\t.option dl {\r\n\t\tdisplay: flex; align-items: flex-start;\r\n\t\tgap: 10px; margin: 0; padding: 12px 0; border-top: 1px solid #f0f0f0; font-size: 15px;\r\n\t}\r\n\t\r\n\t.option dl:first-of-type {\r\n\t\tborder-top: 0;\r\n\t}\r\n\t\r\n\t.option dt {\r\n\t\twidth: 140px; flex-shrink: 0; display: flex; align-items: center; font-weight: 700; color: #222; line-height: 1.4;\r\n\t}\r\n\t\r\n\t.option dd {\r\n\t\tmargin: 0; flex: 1; font-weight: 400; color: #555; line-height: 1.5; word-break: keep-all;\r\n\t}\r\n\t\r\n\t.option i {\r\n\t\tfont-family: xeicon !important; font-size: 16px; margin-right: 6px;\r\n\t}\r\n\t\r\n\t.textBox {\r\n\t\tmargin-top: 18px; color: #333; line-height: 1.65;\r\n\t}\r\n\t\r\n\t.textBox p {\r\n\t\tfont-size: 15px; margin: 0 0 16px; color: #555;\r\n\t}\r\n\t\r\n\t@media (max-width:1024px) {\r\n\t\t.sectionTitleH2 {\r\n\t\t\tfont-size: 4.2rem;\r\n\t\t}\r\n\t\t.font-28 {\r\n\t\t\tfont-size: 18px;\r\n\t\t}\r\n\t\t.block {\r\n\t\t\tmax-width: 100%;\r\n\t\t}\r\n\t}\r\n\t\r\n\t@media (max-width:600px) {\r\n\t\t.titleBox {\r\n\t\t\tpadding: 0 14px;\r\n\t\t}\r\n\t\t.sectionTitleH2 {\r\n\t\t\tfont-size: 2.8rem; line-height: 1.1;\r\n\t\t}\r\n\t\t.font-28 {\r\n\t\t\tfont-size: 16px; margin-bottom: 14px;\r\n\t\t}\r\n\t\t.option dl {\r\n\t\t\tflex-direction: column; gap: 6px; padding: 12px 0;\r\n\t\t}\r\n\t\t.option dt {\r\n\t\t\twidth: auto; font-size: 14px;\r\n\t\t}\r\n\t\t.option dd {\r\n\t\t\tfont-size: 14px; padding-left: 22px;\r\n\t\t}\r\n\t\t.option i {\r\n\t\t\tfont-size: 15px;\r\n\t\t}\r\n\t\t.option h6,\r\n\t\t.textBox h6 {\r\n\t\t\tfont-size: 15px;\r\n\t\t}\r\n\t\t.textBox p {\r\n\t\t\tfont-size: 14px;\r\n\t\t}\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"titleBox\"><h2 class=\"sectionTitleH2\">실리콘</h2>\r\n\r\n<p class=\"font-28\">다목적 건축자재용</p>\r\n\r\n<div class=\"option block\">\r\n\r\n<h6>상품 사양</h6>\r\n\r\n<dl>\r\n<dt><i class=\"xi-check-circle-o\"></i>제조</dt>\r\n<dd>(주)한신실리콘(대한민국)</dd>\r\n</dl>\r\n\r\n<dl>\r\n<dt><i class=\"xi-check-circle-o\"></i>용량</dt>\r\n<dd>300ml</dd>\r\n</dl>\r\n\r\n<dl>\r\n<dt><i class=\"xi-check-circle-o\"></i>경화</dt>\r\n<dd>7~14일</dd>\r\n</dl>\r\n\r\n</div>\r\n\r\n<div class=\"textBox block\">\r\n\r\n<h6>상품 설명</h6>\r\n\r\n<p>\r\nHS300P는 중성경화형의 1액형 제품으로 작업성, 경제성, 내구성, 내후성을 겸비한 다목적 실리콘 실란트입니다.\r\n</p>\r\n\r\n<h6>특이사항</h6>\r\n\r\n<p>각종 창호, 유리공사<br />쇼윈도우 실링<br />알루미늄, PVC, 목재등의 샷시 및 조인트 실링<br />기타 건축자재 실링<br /></p>\r\n\r\n</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}