-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>티크 집성판 / 사이드핑거</h2>\r\n<div class=\"ds-block-title\">티크 집성판 / 사이드핑거 한눈에 보기</div><div class=\"ds-ai-summary\"><p>금갈색부터 암갈색까지 이어지는 줄무늬와 시간이 지나며 깊어지는 색이 특징인 티크 집성판입니다.</p><p>세계적으로는 최고급 목재로 유명하지만 국내 집성목 시장에서는 높은 가격과 뚜렷한 취향 때문에 잔잔한 수요가 이어지는 수종입니다.</p><p>이 상품은 무절 사이드핑거로 판매합니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">세계적으로 이름난 고급 목재입니다</div><p>티크는 선박재와 고급 가구재로 오래전부터 알려진 수종입니다. 국내 집성목에서는 오크·애쉬처럼 대중적인 고급 하드우드까지는 아니지만 티크 특유의 색과 결을 찾는 고객이 꾸준히 있습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">시간이 지나면서 색이 더 깊어집니다</div><p>심재는 금갈색에서 암갈색까지 줄무늬가 나타나고 시간이 지나면서 색이 더 짙어지는 경향이 있습니다. 처음의 색과 오래 사용한 뒤의 색이 조금 달라지는 것도 티크의 특징입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">물과 마모에 강한 목재로 알려져 있습니다</div><p>티크는 오래전부터 선박 갑판이나 야외 가구에 쓰일 만큼 내구성이 좋은 목재로 알려져 있습니다. 이런 배경 때문에 실내 가구에서도 오래 쓰는 고급 목재라는 이미지가 강합니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">사이드핑거가 주력입니다</div><p>국내에서 접하는 티크 집성판은 무절 사이드핑거가 중심입니다. 솔리드도 일부 유통되지만 가격이 더 높고 규격도 일정하지 않아 일반적으로는 사이드핑거를 먼저 봅니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">예전에는 지브라·브러쉬 제품도 있었습니다</div><p>변재와 심재의 색 차이를 일부러 살린 ‘티크 지브라’, 표면을 브러쉬 가공해 질감을 강조한 ‘티크 브러쉬’ 같은 파생 제품도 국내에 유통된 적이 있습니다. 티크가 색과 질감을 적극적으로 활용해 온 수종이라는 걸 보여주는 사례입니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>910×2440mm / 1220×2440mm</td></tr><tr><th>두께옵션</th><td>910폭: 12/15/18/24/30T · 1220폭: 15/18/24/30T</td></tr><tr><th>집성방식</th><td>사이드핑거 / 무절</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/45.png?v=20260714\" alt=\"티크 집성판의 골드브라운·황갈색 표면과 자연스러운 나뭇결, 사이드핑거 집성 구조를 설명한 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 1220×2440mm에는 12T 판매 옵션이 없습니다.</p><p>• 시간이 지나며 색이 짙어지는 특성을 감안해 주변 마감재와 같이 보는 게 좋습니다.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 티크는 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">가격보다 티크 특유의 금갈색·암갈색 줄무늬와 시간이 지나며 깊어지는 색을 중요하게 보는 분께 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 색이 시간이 지나면 변하나요?</p><p class=\"ds-faq-a\">네. 티크는 시간이 지나면서 전체 색이 조금 더 짙고 깊게 보이는 경향이 있습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 티크 지브라나 브러쉬도 판매하나요?</p><p class=\"ds-faq-a\">그런 파생 제품이 국내에 유통된 적은 있지만 현재 이 상품은 일반 티크 사이드핑거 집성판입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 1220폭 12T도 있나요?</p><p class=\"ds-faq-a\">아니요. 12T는 910×2440mm 규격에서만 판매합니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}