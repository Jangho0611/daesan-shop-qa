nt-weight: 700; color: #1C1C1C; margin: 32px 0 14px; padding-left: 10px; border-left: 4px solid #123628;\r\n\t}\r\n\t\r\n\t.ds-wrap h2 + .ds-block-title {\r\n\t\tmargin-top: 0;\r\n\t}\r\n\t\r\n\t.ds-ai-summary {\r\n\t\tbackground: #FBFCF8; border: 1px solid #E3E1D8; border-left: 3px solid #123628; border-radius: 6px; padding: 18px; margin: 0 0 22px 0; font-size: 15px; color: #1C1C1C;\r\n\t}\r\n\t\r\n\t.ds-ai-summary p {\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\t\r\n\t.ds-ai-summary p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\t\r\n\t.ds-define {\r\n\t\tbackground: #FAFAF7; border-left: 3px solid #123628; border-radius: 6px; color: #616161; padding: 18px; margin: 0 0 22px 0; font-size: 15px;\r\n\t}\r\n\t\r\n\t.ds-spec-table {\r\n\t\twidth: 100%; border-collapse: separate; border-spacing: 0; margin: 0 0 22px 0; border-top: 1px solid #E6E3DA;\r\n\t}\r\n\t\r\n\t.ds-spec-table th {\r\n\t\tbackground: #FAFAF7; color: #616161; font-weight: 600; font-size: 14px; padding: 13px 12px; border-bottom: 1px solid #E6E3DA; width: 30%; text-align: left;\r\n\t}\r\n\t\r\n\t.ds-spec-table td {\r\n\t\tbackground: #FFFFFF; color: #1C1C1C; font-weight: 400; font-size: 15px; padding: 13px 12px; border-bottom: 1px solid #E6E3DA; text-align: left;\r\n\t}\r\n\t\r\n\t.ds-section-title {\r\n\t\tfont-size: 18px; font-weight: 700; color: #1C1C1C; margin: 24px 0 12px;\r\n\t}\r\n\t\r\n\t.ds-infographic {\r\n\t\tborder: 1px solid #E0E0E0; border-radius: 4px; overflow: hidden; margin: 0 0 24px 0;\r\n\t}\r\n\t\r\n\t.ds-infographic-stack {\r\n\t\tdisplay: block; margin: 0; padding: 0; line-height: 0; gap: 0;\r\n\t}\r\n\t\r\n\t.ds-infographic-stack img {\r\n\t\tdisplay: block; width: 100%; max-width: 100%; height: auto; margin: 0; padding: 0;\r\n\t}\r\n\t\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7; border: 1px solid #E3E1D8; border-top: 2px solid #123628; border-radius: 6px; padding: 18px; margin: 0 0 22px 0; font-size: 15px; color: #616161;\r\n\t}\r\n\t\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\t\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\t\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\t\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0; padding: 0;\r\n\t}\r\n\t\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA; border: 1px solid #DEDAD0; border-radius: 6px; padding: 15px 16px; margin: 0 0 12px 0;\r\n\t}\r\n\t\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px; font-weight: 800; color: #123628; margin: 0 0 6px 0;\r\n\t}\r\n\t\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px; color: #616161; margin: 0;\r\n\t}\r\n\t\r\n\t.ds-cta {\r\n\t\tdisplay: block; width: 100%; background: #123628; color: #FFFFFF; padding: 16px; border-radius: 6px; text-align: center; text-decoration: none; font-size: 15px; font-weight: 600; margin: 0 0 12px 0;\r\n\t}\r\n\t\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\t\r\n\t.ds-phone {\r\n\t\tcolor: #616161; font-size: 13px; text-align: center; margin: 0 0 20px 0;\r\n\t}\r\n\t\r\n\t.ds-footer {\r\n\t\tbackground: #123628; color: #FFFFFF; text-align: center; padding: 20px; font-size: 13px;\r\n\t}\r\n\t\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block; width: 100%;\r\n\t\t}\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\">\r\n\r\n<h2>방염 MDF (선방염 기성품)</h2>\r\n\r\n<div class=\"ds-block-title\">방염 MDF 한눈에 보기</div>\r\n<div class=\"ds-ai-summary\">\r\n<p>방염 MDF는 MDF 제조 공정에서 목섬유 원료에 방염 성분을 적용해 성형한 방염 처리 MDF입니다.</p>\r\n\r\n<p>MDF는 목재 섬유를 접착수지와 함께 압착 성형한 목질 판재로, 표면이 균일하고 매끄러워 도장·필름·무늬목 등 다양한 마감에 사용됩니다.</p>\r\n\r\n<p>이 상품은 별도의 후가공 도포 방식이 아니라 제조 단계에서 방염 처리가 적용된 기성품으로, 두께·밀도·재고 여부를 주문 전에 확인하는 것이 좋습니다.</p>\r\n</div>\r\n\r\n<div class=\"ds-block-title\">방염 MDF 소개</div>\r\n<div class=\"ds-define\">\r\n\r\n<p><strong>방염 MDF 기성품은 완성된 보드에 방염 도료를 후가공으로 도포하는 방식이 아니라, MDF 제조 공정에서 원료가 되는 목섬유에 방염 성분을 적용해 성형하는 방식으로 생산됩니다.</strong></p>\r\n\r\n<p><strong>따라서 자작합판·일반합판의 후가공 방염 제품과는 처리 방식이 다르며, 공장에서 제조되는 단계부터 방염 MDF 형태로 생산되는 제품입니다.</strong></p>\r\n\r\n<p><strong>원하시는 MDF 규격이나 옵션이 기성품과 다른 경우에는 일반 MDF 구매 후 별도 방염가공 방식도 상담할 수 있습니다.</strong></p>\r\n</div>\r\n\r\n<div class=\"ds-block-title\">규격 정보</div>\r\n\r\n<table class=\"ds-spec-table\"><tbody><tr><th>규격</th>\r\n<td>1220×2440mm</td></tr>\r\n<tr><th>두께 옵션</th>\r\n<td>9T / 12T / 15T / 18T\r\n<br />\r\n</td></tr>\r\n<tr><th>MDF 옵션</th>\r\n<td>국산 / 580급 중밀도\r\n<br />\r\n</td></tr>\r\n<tr><th>방염 옵션</th>\r\n<td>제조 공정 내 방염액 첨가(원료 단계 처리)\r\n<br />\r\n</td></tr>\r\n<tr><th>출고안내</th>\r\n<td>주문재 / 재고 보유 시 소량~대량 출고 가능하나, 출고 관련 별도 상담 필요</td></tr></tbody></table>\r\n\r\n<div class=\"ds-section-title\">방염 공정과 처리 방식 비교</div>\r\n<div class=\"ds-infographic\">\r\n<img alt=\"방염 MDF의 제조 공정과 방염MDF·방염필름 차이점을 설명한 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/64.png?v=20260714\" />\r\n</div>\r\n\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div>\r\n<div class=\"ds-reason\">\r\n\r\n<p><strong>※ 해당 상품은 제조 단계에서부터 방염처리가 이미 완료된 기성품으로 옵션이 사전에 정해져 있으므로, 필요한 방염 MDF의 두께·밀도·납기 일정을 주문 전에 확인해 주세요.</strong></p>\r\n\r\n<p><strong>※ 방염 성능은 제조·인증 단계에서 검증되며, 자작합판·일반합판 방염가공 제품과 달리 출고 시 방염성능검사를 위한 시료채취나 임의 재단이 발생하지 않습니다.</strong></p>\r\n\r\n<p><strong>※ 재단작업, 합짐출고 등이 필요한 경우 별도 상담이 필요합니다.</strong></p>\r\n</div>\r\n\r\n<div class=\"ds-block-title\">자주 묻는 질문</div>\r\n\r\n<div class=\"ds-faq\">\r\n\r\n<div class=\"ds-faq-item\">\r\n\r\n<p class=\"ds-faq-q\">Q. 방염 MDF는 자작합판·일반합판 방염 제품과 무엇이 다른가요?</p>\r\n\r\n<p class=\"ds-faq-a\">자작합판·일반합판은 이미 만들어진 합판에 방염 도료를 도포하는 후가공 방식인 반면, 방염 MDF는 MDF 제조 시 목섬유에 방염액을 첨가해 성형하는 방식으로, 보드 자체가 처음부터 방염 상태로 생산됩니다.</p>\r\n</div>\r\n\r\n<div class=\"ds-faq-item\">\r\n\r\n<p class=\"ds-faq-q\">Q. 소량 주문도 가능한가요?</p>\r\n\r\n<p class=\"ds-faq-a\">해당 상품은 제조 단계에서 방염 처리가 적용된 기성품으로, 재고 보유 시 1장부터 출고가 가능합니다. 수량이 많을 경우 재고 및 납기 확인이 필요하므로 주문 전 상담을 권장합니다.</p>\r\n</div>\r\n\r\n<div class=\"ds-faq-item\">\r\n\r\n<p class=\"ds-faq-q\">Q. 방염 필증(딱지)은 어떻게 확인하나요?</p>\r\n\r\n<p class=\"ds-faq-a\">제조·인증 단계에서 방염 성능 검증을 거친 제품으로, 정상부착된 방염 필증을 확인하실 수 있으며, 방염증명서가 필요하신 경우 별도로 발급요청해주시면 됩니다.</p>\r\n</div>\r\n\r\n</div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}