-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>자작나무 집성판 / 사이드핑거</h2>\r\n<div class=\"ds-block-title\">자작나무 집성판 / 사이드핑거 한눈에 보기</div><div class=\"ds-ai-summary\"><p>화사한 크림색에서 옅은 황색을 띠는 자작나무 무절 집성판입니다.</p><p>자작합판으로는 매우 익숙한 수종이지만 집성판은 상대적으로 유통량이 적은 편입니다.</p><p>단단하면서도 가공성이 좋은 자작나무의 재질감은 집성판에서도 그대로 느낄 수 있습니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">자작합판과 인지도 차이가 큰 수종입니다</div><p>자작나무 하면 대부분 자작합판을 먼저 떠올립니다. 같은 수종의 집성판도 있지만 가격대가 높은 데다 표면 결이 합판처럼 길게 이어지지 않아 국내에서는 상대적으로 비주류로 남아 있습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">자작합판과 표면이 다른 이유가 있습니다</div><p>자작합판은 큰 단판의 결이 한 면에 길게 이어지지만 집성판은 여러 원목 조각을 이어 만듭니다. 그래서 같은 자작나무라도 정면에서 보이는 결의 분위기는 꽤 다르게 느껴집니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">밝고 균일한 색은 그대로 살아 있습니다</div><p>색은 자작합판과 비슷한 화사한 크림색~옅은 황색입니다. 큰 옹이가 없는 무절 제품이라 강한 무늬보다 밝고 매끈한 면을 원하는 제작에 잘 맞습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">단단하면서 가공하기 좋은 편입니다</div><p>자작나무는 단단한 편이면서도 가공성이 좋아 주방가구, 소형가구, 장난감, 바닥재 등 여러 용도로 쓰여온 수종입니다. 집성판에서도 이런 재질적 장점은 그대로 이어집니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">합판과 다른 면 구성이 필요할 때 봅니다</div><p>자작합판의 적층 단면이나 길게 이어지는 무늬가 목적이 아니라, 원목 조각을 이어 만든 매끈한 집성판 면이 필요하다면 자작 집성판이 별도의 선택지가 됩니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>1220×2440mm</td></tr><tr><th>두께옵션</th><td>15T / 18T / 24T / 30T</td></tr><tr><th>집성방식</th><td>사이드핑거 / 무절</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img alt=\"자작나무 집성판의 밝고 맑은 원목 색감과 곱고 선명한 나뭇결, 사이드핑거 핑거조인트 집성 구조를 보여주는 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/57.png?v=20260714\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 12T는 판매 옵션에 없습니다.</p><p>• 자작합판과 구조가 완전히 다르므로 원하는 단면과 표면을 먼저 확인해 주세요.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 자작 집성판은 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">자작 특유의 화사한 색과 단단하면서 가공하기 좋은 재질은 원하지만, 합판이 아닌 매끈한 원목 집성판 면을 원하는 분께 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 자작합판과 같은 자재인가요?</p><p class=\"ds-faq-a\">아닙니다. 합판은 얇은 단판을 여러 겹 적층하고, 집성판은 원목 조각을 이어 판을 만듭니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 왜 자작합판보다 덜 흔한가요?</p><p class=\"ds-faq-a\">집성판은 결이 합판처럼 길게 이어지지 않는 데다 가격도 고급 하드우드급이라 자작합판 쪽으로 수요가 많이 몰리는 편입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 12T도 있나요?</p><p class=\"ds-faq-a\">현재 판매 제품은 15T부터 시작합니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div>\n\n</div></body></html>","additional":[],"unconfirmed":false}