{"detail":"<!doctype html><html lang=\"ko\"><head><meta charset=\"utf-8\"><meta http-equiv=\"Content-Security-Policy\" content=\"default-src 'none'; script-src 'none'; style-src 'unsafe-inline'; font-src 'self'; img-src https://daesan.ai https://*.daesan.ai https://cafe24img.com https://*.cafe24img.com https://www.kccworld.co.kr/assets/images/ho/bm/img_hb_mark.jpg; connect-src 'none'; base-uri 'none'; form-action 'none'\"><meta name=\"referrer\" content=\"no-referrer\"><style>@font-face{font-family:Pretendard;font-weight:400;src:url(fonts/400) format(\"woff2\");font-display:swap}@font-face{font-family:Pretendard;font-weight:500;src:url(fonts/500) format(\"woff2\");font-display:swap}@font-face{font-family:Pretendard;font-weight:600;src:url(fonts/600) format(\"woff2\");font-display:swap}@font-face{font-family:Pretendard;font-weight:700;src:url(fonts/700) format(\"woff2\");font-display:swap}@font-face{font-family:Pretendard;font-weight:800;src:url(fonts/800) format(\"woff2\");font-display:swap}html,body{margin:0;padding:0}body{display:flow-root;font:12px/1.5 Pretendard,sans-serif;color:#353535}p,h1,h2,h3,h4,h5,h6,ul,ol,li,dl,dt,dd,figure{margin:0;padding:0}table{width:100%;border:0;border-spacing:0;border-collapse:collapse}img{border:0;vertical-align:top;max-width:100%}a{color:inherit;text-decoration:none}#cafe24-detail{max-width:790px;margin:auto}@media(min-width:701px){#cafe24-detail h3.ds-block-title{font-size:12px;margin:0 0 20px}}@media(max-width:700px){body{font-size:13px;line-height:1.2;color:#1b1b1b}td,th{line-height:18px}#cafe24-detail{width:95.25%}}</style><style>\r\n\t.ds-wrap {\r\n\t\tmax-width: 790px;\r\n\t\tmargin: 0 auto;\r\n\t\tfont-family: 'Pretendard', 'Apple SD Gothic Neo', 'Noto Sans KR', sans-serif;\r\n\t\tline-height: 1.75;\r\n\t\tcolor: #1C1C1C;\r\n\t}\r\n\r\n\t.ds-wrap * {\r\n\t\tbox-sizing: border-box;\r\n\t}\r\n\r\n\t.ds-wrap h2 {\r\n\t\tfont-size: 28px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #1C1C1C;\r\n\t\tmargin: 0 0 24px;\r\n\t}\r\n\r\n\t.