-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>라디에타파인 / 계단재</h2>\r\n<div class=\"ds-block-title\">라디에타파인 / 계단재 한눈에 보기</div><div class=\"ds-ai-summary\"><p>라디에타파인을 계단판·봉·손스침 규격으로 가공한 계단용 부재입니다.</p><p>밝은 소나무 결을 한 수종으로 맞추면서 계단 구성에 필요한 여러 부재를 함께 고를 수 있습니다.</p><p>계단판부터 소봉·대봉·반봉·두 가지 손스침까지 실제 판매 규격에 맞춰 선택합니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">계획 재배로 공급이 꾸준한 소나무입니다</div><p>라디에타파인은 뉴질랜드와 칠레 등에서 계획적으로 재배되는 소나무라 원목 공급이 비교적 안정적입니다. 다양한 두께를 꾸준히 구하기 쉬워 국내 소프트우드 집성목의 대표 수종으로 자리잡았습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">스프러스보다 단단하고 하드우드보다 부담이 적습니다</div><p>스프러스보다 조금 더 단단하게 느껴지는 편이면서 오크·월넛 같은 하드우드보다는 가격 부담이 훨씬 적습니다. 가공성도 무난해서 실속 있는 파인계열 집성목을 찾을 때 많이 봅니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">옵션 구성이 유난히 다양한 수종입니다</div><p>탑핑거 무절뿐 아니라 솔리드에서도 양면유절·양면무절·일면무절이 유통되는 수종입니다. 같은 라디에타파인 안에서 표면과 집성 방식까지 폭넓게 비교할 수 있다는 게 큰 특징입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">집성판이 아니라 계단 구성에 맞춘 전용 부재입니다</div><p>계단판은 디딤판 쪽에 쓰고, 봉과 손스침은 난간 구성에 맞춰 선택합니다. 같은 수종이라 색감은 이어가면서 부위별 필요한 단면을 따로 고르는 제품입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">부재별 역할을 나눠서 수량을 잡는 게 중요합니다</div><p>계단판 폭과 길이만 보고 주문하면 봉이나 손스침 수량이 빠지기 쉽습니다. 현장 계단 수와 난간 길이를 먼저 확인하고 부재별로 수량을 나눠 계산하는 게 좋습니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>계단판</th><td>30×300×3600 / 38×300×3600 / 38×610×3600</td></tr><tr><th>봉</th><td>소봉 40×40×900 / 대봉 90×90×1200 / 반봉 45×90×1200</td></tr><tr><th>손스침</th><td>반달 40×70×3600 / 식빵 60×70×3600</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/40.png?v=20260714\" alt=\"라디에타파인 계단재의 계단판과 봉, 손스침 구성 및 규격을 보여주는 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 계단판·봉·손스침은 서로 용도가 다른 부재라 필요한 수량을 각각 계산해야 합니다.</p><p>• 현장 실측 치수와 재단 여유를 같이 잡아 주세요.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 라디에타파인 계단재는 어떤 경우에 잘 맞나요?</p><p class=\"ds-faq-a\">밝은 목재 계단을 만들면서 계단판과 난간 부재까지 같은 수종으로 맞추고 싶은 현장에 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 38×610 계단판은 왜 폭이 넓나요?</p><p class=\"ds-faq-a\">넓은 판이 필요한 계단이나 현장 재단용으로 볼 수 있습니다. 실제 사용 폭은 현장 치수에 맞춰 재단합니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 손스침은 어떤 모양이 있나요?</p><p class=\"ds-faq-a\">반달손스침과 식빵손스침 두 가지가 있습니다. 손에 잡히는 형태와 디자인을 보고 고르면 됩니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 주문 전에 가장 먼저 볼 건 뭔가요?</p><p class=\"ds-faq-a\">계단 수, 디딤판 치수, 난간 길이를 먼저 확인한 뒤 부재별 규격과 수량을 나누는 게 좋습니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}