-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>애쉬 집성판 / 사이드핑거</h2>\r\n<div class=\"ds-block-title\">애쉬 집성판 / 사이드핑거 한눈에 보기</div><div class=\"ds-ai-summary\"><p>물푸레나무라고도 부르는 애쉬 무절 집성판으로, 길고 부드럽게 흐르는 결이 특징입니다.</p><p>오크와 함께 고급 하드우드 집성목을 대표하는 수종으로 꾸준히 비교됩니다.</p><p>이 상품은 사이드핑거 무절이며 915×2300과 1220×2440 두 규격을 판매합니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">오크와 함께 고급 하드우드의 양대 수종입니다</div><p>월넛처럼 더 비싼 수종도 있지만 가격과 취향 부담까지 생각하면 실제 가구재에서는 오크와 애쉬를 먼저 비교하는 경우가 많습니다. 고급스러운 하드우드를 무리 없이 쓰고 싶을 때 대표적으로 보는 수종입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">애쉬는 길고 흐르는 결이 특징입니다</div><p>오크가 짧고 끊기는 듯한 무늬가 눈에 띈다면 애쉬는 긴 선이 부드럽게 이어지는 느낌이 강합니다. 넓은 상판에서 결을 시원하게 보여주고 싶을 때 애쉬 쪽을 선호하는 분들이 있습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">원목 산지와 가공지가 다를 수 있습니다</div><p>북미나 유럽에서 나온 원목을 중국에서 집성판으로 가공해 국내로 들여오는 제품이 많습니다. 그래서 원목 산지와 완제품 가공지가 다르게 표시될 수 있는 수종입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">산지와 개체에 따라 색 차이가 있습니다</div><p>기본은 브라운 계열이지만 톤이 일정한 한 가지 색으로만 보이지는 않습니다. 밝고 화사한 이색이 도드라지는 애쉬도 있어 여러 장을 쓸 때는 실제 색을 맞춰보는 게 좋습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">사이드핑거가 주력이고 솔리드는 별도 시장입니다</div><p>애쉬 솔리드도 일부 유통되지만 가격이 크게 올라가고 규격도 일정하지 않습니다. 실제 판매 상품은 규격이 안정적인 사이드핑거 무절 기준으로 보면 됩니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>915×2300mm / 1220×2440mm</td></tr><tr><th>두께옵션</th><td>12T / 15T / 18T / 24T / 30T</td></tr><tr><th>집성방식</th><td>사이드핑거 / 무절</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img alt=\"애쉬 집성판의 밝은 원목 색감과 굵고 선명한 나뭇결, 사이드핑거 핑거조인트 집성 구조를 보여주는 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/58.png?v=20260714\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 결이 뚜렷한 수종이라 여러 장을 이어 쓸 때 결 방향을 먼저 맞춰 주세요.</p><p>• 두 판 규격 중 재단 손실이 적은 쪽을 고르는 게 좋습니다.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 애쉬는 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">고급 하드우드의 단단한 느낌과 함께 길고 시원하게 흐르는 결을 넓게 보여주고 싶은 분께 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 오크와 가장 쉽게 구분하는 부분은 뭔가요?</p><p class=\"ds-faq-a\">애쉬는 긴 선이 흐르는 결이 강하고, 오크는 짧고 끊기는 듯한 무늬가 더 눈에 띕니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 원산지와 가공지가 왜 다를 수 있나요?</p><p class=\"ds-faq-a\">북미·유럽 원목을 중국에서 집성판으로 가공해 수입하는 경우가 많기 때문입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 솔리드도 판매하나요?</p><p class=\"ds-faq-a\">현재 이 상품은 사이드핑거 무절 기준으로 판매합니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div>\n\n</div></body></html>","additional":[],"unconfirmed":false}