-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>오동나무 집성판 / 솔리드</h2>\r\n<div class=\"ds-block-title\">오동나무 집성판 / 솔리드 한눈에 보기</div><div class=\"ds-ai-summary\"><p>회백색에서 은백색에 가까운 밝은 색과 아주 가벼운 무게가 특징인 오동나무 집성판입니다.</p><p>국내 집성목 시장에서는 보기 드문 수종이고, 이 상품은 12T 솔리드 무절 한 가지 규격으로 판매합니다.</p><p>바탕색과 결이 연해 원하는 색을 입히는 착색 작업에도 유리한 편입니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">옛 수납가구 이야기로 익숙한 나무입니다</div><p>예전에는 딸을 낳으면 오동나무를 심었다가 혼수 장을 만들어줬다는 이야기가 있을 만큼 수납가구재로 이름이 익숙한 수종입니다. 하지만 요즘 집성판 시장에서는 실제 제품을 접해본 고객이 많지 않을 정도로 비주류입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">집성목 가운데서도 매우 가벼운 편입니다</div><p>오동나무의 가장 큰 특징은 무게입니다. 특히 12T 솔리드는 들어보면 다른 집성판보다 확실히 가볍고 유연하게 느껴져, 무거운 하중보다는 가벼운 가구나 부재에 더 잘 맞습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">솔리드인데 집성 폭이 넓은 편입니다</div><p>오동나무 집성판은 폭이 약 10cm 정도 되는 넓은 목재 조각을 이어 만든 제품이 확인됩니다. 일반적인 좁은 집성판과 비교하면 한 조각의 폭이 넓어 표면 구성도 조금 다르게 보입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">밝은 바탕은 착색할 때 장점이 됩니다</div><p>회백색~은백색 바탕에 결도 강하게 튀지 않아 원하는 색을 입힐 때 원래 목재 색의 간섭이 적습니다. 진한 결과 색이 남는 파인류보다 컬러를 비교적 깨끗하게 올리기 좋습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">구하기 쉬운 수종은 아닙니다</div><p>대부분의 집성 전문 수입상이 상시 취급하는 품목은 아닙니다. 흔한 자재보다 가벼움이나 착색 같은 분명한 목적이 있을 때 찾는 특수한 선택지에 가깝습니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>1220×2440mm</td></tr><tr><th>두께옵션</th><td>12T</td></tr><tr><th>집성방식</th><td>솔리드 / 무절</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/50.png?v=20260714\" alt=\"오동나무 집성판의 밝은 황백색·연한 베이지 표면과 부드러운 나뭇결, 솔리드 집성 구조를 설명한 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 얇고 가벼워 원판 운반이나 세워 보관할 때 휨을 조심해 주세요.</p><p>• 무거운 하중이 걸리는 상판보다 가벼운 제작에 더 잘 맞습니다.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 오동나무는 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">무게를 줄여야 하거나 밝은 바탕에 원하는 색을 입히는 제작을 계획한 분께 잘 맞습니다. 흔한 수종보다 목적이 분명할 때 선택하는 편입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 왜 오동나무 장 이야기가 많나요?</p><p class=\"ds-faq-a\">예전부터 가볍고 수납가구재로 알려져 혼수 장과 연결된 이야기가 많이 전해집니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 두께는 12T만 있나요?</p><p class=\"ds-faq-a\">현재 판매 제품은 12T, 1220×2440mm 한 가지입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 상판으로 써도 되나요?</p><p class=\"ds-faq-a\">가벼운 용도라면 가능하지만 무게가 많이 실리는 상판이라면 더 단단한 수종을 같이 보는 게 좋습니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}