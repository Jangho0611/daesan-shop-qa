-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>엘더(오리나무) 집성판 / 사이드핑거</h2>\r\n<div class=\"ds-block-title\">엘더(오리나무) 집성판 / 사이드핑거 한눈에 보기</div><div class=\"ds-ai-summary\"><p>붉은 기가 살짝 도는 따뜻한 갈색과 잔잔한 결이 특징인 엘더 무절 집성판입니다.</p><p>예전 가구공장에서 많이 쓰던 수종이지만 요즘은 고무나무 착색 제품으로 대체되는 경우가 늘어 예전보다 사용량이 줄었습니다.</p><p>20T·25T 중심의 독특한 두께 구성을 가진 것도 다른 집성목과 구분되는 부분입니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">오래전부터 가구재로 자리를 지켜온 수종입니다</div><p>엘더는 화려하게 주목받는 수종은 아니지만 예전부터 가구공장에서 꾸준히 써왔습니다. 따뜻하고 차분한 색감을 좋아하는 수요가 있어 지금도 기성 집성판으로 계속 유통됩니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">자작과 헷갈리기도 하지만 분위기는 다릅니다</div><p>자작나무와 같은 과에 속해 실물을 얼핏 보면 비슷하게 느끼는 경우도 있습니다. 엘더는 붉은 기가 도는 따뜻한 갈색이 조금 더 살아 있어 자작의 화사한 크림색과는 다른 분위기입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">솔리드보다 사이드핑거 무절로 자리잡았습니다</div><p>엘더 원목에는 작은 옹이가 많은 편이라 솔리드로 깨끗한 판을 구성하기가 까다롭습니다. 국내에서는 사이드핑거 무절이 사실상 표준으로 자리잡은 이유이기도 합니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">두께 구성이 다른 집성목과 조금 다릅니다</div><p>일반 집성판은 12T·15T부터 시작하는 경우가 많지만 엘더는 20T·25T가 중심입니다. 북미산 원목이 중국에서 가공돼 들어오는 유통 구조와 함께 엘더만의 독특한 규격 구성이 이어져 왔습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">요즘은 고무나무 착색 제품과도 경쟁합니다</div><p>예전에는 엘더 원목 자체를 많이 썼지만 최근에는 비용을 줄이기 위해 밝은 고무나무에 엘더 색을 입혀 대체하는 경우가 늘었습니다. 그래도 착색으로 흉내낸 색이 아니라 엘더 원목 자체의 분위기를 원하는 분들은 여전히 찾습니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>18/20/25T: 1220×2440mm / 33T: 1200×2400mm</td></tr><tr><th>두께옵션</th><td>18T / 20T / 25T / 33T</td></tr><tr><th>집성방식</th><td>사이드핑거 / 무절</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/44.png?v=20260714\" alt=\"엘더 오리나무 집성판의 따뜻한 연황색과 연갈색 색감, 고른 나뭇결과 사이드핑거 집성 구조를 보여주는 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 33T는 다른 두께와 판 규격이 다르니 재단 전에 확인해 주세요.</p><p>• 붉은 기와 색 농도는 판마다 조금씩 다르게 보일 수 있습니다.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 엘더는 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">고무나무에 색을 입힌 느낌보다 엘더 원목 자체의 따뜻하고 차분한 색과 질감을 원하는 분께 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 자작과 비슷한가요?</p><p class=\"ds-faq-a\">밝은 계열이라는 점은 비슷하지만 엘더는 붉은 기가 조금 더 돌고 분위기도 따뜻한 편입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 왜 20T·25T가 중심인가요?</p><p class=\"ds-faq-a\">엘더는 일반 집성판과 달리 12T·15T가 없고 20T·25T 중심으로 오래 유통돼 온 수종입니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 33T 규격도 1220×2440인가요?</p><p class=\"ds-faq-a\">아닙니다. 33T는 1200×2400mm입니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}