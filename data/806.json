-width: 100%;\r\n\t\theight: auto;\r\n\t\tmargin: 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-reason {\r\n\t\tbackground: #FAFAF7;\r\n\t\tborder: 1px solid #E3E1D8;\r\n\t\tborder-top: 2px solid #123628;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 18px;\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tfont-size: 15px;\r\n\t\tcolor: #616161;\r\n\t}\r\n\r\n\t.ds-ai-summary,\r\n\t.ds-define,\r\n\t.ds-spec-table,\r\n\t.ds-infographic,\r\n\t.ds-reason {\r\n\t\tmargin-bottom: 24px;\r\n\t}\r\n\r\n\t.ds-reason p {\r\n\t\tmargin: 0 0 8px 0;\r\n\t}\r\n\r\n\t.ds-reason p:last-child {\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-faq {\r\n\t\tmargin: 0 0 22px 0;\r\n\t\tpadding: 0;\r\n\t}\r\n\r\n\t.ds-faq-item {\r\n\t\tbackground: #FCFCFA;\r\n\t\tborder: 1px solid #DEDAD0;\r\n\t\tborder-radius: 6px;\r\n\t\tpadding: 15px 16px;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-faq-q {\r\n\t\tfont-size: 16px;\r\n\t\tfont-weight: 800;\r\n\t\tcolor: #123628;\r\n\t\tmargin: 0 0 6px 0;\r\n\t}\r\n\r\n\t.ds-faq-a {\r\n\t\tfont-size: 14px;\r\n\t\tcolor: #616161;\r\n\t\tmargin: 0;\r\n\t}\r\n\r\n\t.ds-cta {\r\n\t\tdisplay: block;\r\n\t\twidth: 100%;\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\tpadding: 16px;\r\n\t\tborder-radius: 6px;\r\n\t\ttext-align: center;\r\n\t\ttext-decoration: none;\r\n\t\tfont-size: 15px;\r\n\t\tfont-weight: 600;\r\n\t\tmargin: 0 0 12px 0;\r\n\t}\r\n\r\n\t.ds-cta:hover {\r\n\t\topacity: 0.92;\r\n\t}\r\n\r\n\t.ds-phone {\r\n\t\tcolor: #616161;\r\n\t\tfont-size: 13px;\r\n\t\ttext-align: center;\r\n\t\tmargin: 0 0 20px 0;\r\n\t}\r\n\r\n\t.ds-footer {\r\n\t\tbackground: #123628;\r\n\t\tcolor: #FFFFFF;\r\n\t\ttext-align: center;\r\n\t\tpadding: 20px;\r\n\t\tfont-size: 13px;\r\n\t}\r\n\r\n\t@media(max-width:768px) {\r\n\t\t.ds-wrap {\r\n\t\t\tpadding: 0 16px;\r\n\t\t}\r\n\r\n\t\t.ds-wrap h2 {\r\n\t\t\tfont-size: 20px;\r\n\t\t}\r\n\r\n\t\t.ds-spec-table th,\r\n\t\t.ds-spec-table td {\r\n\t\t\tdisplay: block;\r\n\t\t\twidth: 100%;\r\n\t\t}\r\n\t}\r\n\r\n\t.ds-intro-group {\r\n\t\tbackground: #FAFAF7;border: 1px solid #E6E3DA;border-radius: 6px;\r\n\t\tpadding: 4px 18px;margin: 0 0 22px 0;\r\n\t}\r\n\t.ds-intro-sub {\r\n\t\tpadding: 14px 0;border-bottom: 1px solid #E6E3DA;\r\n\t}\r\n\t.ds-intro-sub:last-child {\r\n\t\tborder-bottom: 0;\r\n\t}\r\n\t.ds-intro-sub-title {\r\n\t\tfont-size: 15px;font-weight: 700;color: #1C1C1C;margin: 0 0 6px 0;\r\n\t}\r\n\t.ds-intro-sub p {\r\n\t\tfont-size: 15px;color: #1C1C1C;margin: 0;\r\n\t}\r\n\r\n</style></head><body><div id=\"cafe24-detail\">\r\n\r\n<div class=\"ds-wrap\"><h2>라디에타파인 / 솔리드</h2>\r\n<div class=\"ds-block-title\">라디에타파인 / 솔리드 한눈에 보기</div><div class=\"ds-ai-summary\"><p>밝은 소나무 결을 길게 살린 라디에타파인 솔리드 집성판입니다.</p><p>양면유절·양면무절·일면무절 세 가지 표면 옵션이 있어 실제로 보이는 면 수에 맞춰 고를 수 있습니다.</p><p>공급이 안정적인 라디에타파인의 장점에 솔리드 특유의 긴 결을 더한 제품입니다.</p></div>\r\n<div class=\"ds-block-title\">제품 소개</div><div class=\"ds-intro-group\"><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">계획 재배로 공급이 꾸준한 소나무입니다</div><p>라디에타파인은 뉴질랜드와 칠레 등에서 계획적으로 재배되는 소나무라 원목 공급이 비교적 안정적입니다. 다양한 두께를 꾸준히 구하기 쉬워 국내 소프트우드 집성목의 대표 수종으로 자리잡았습니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">스프러스보다 단단하고 하드우드보다 부담이 적습니다</div><p>스프러스보다 조금 더 단단하게 느껴지는 편이면서 오크·월넛 같은 하드우드보다는 가격 부담이 훨씬 적습니다. 가공성도 무난해서 실속 있는 파인계열 집성목을 찾을 때 많이 봅니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">옵션 구성이 유난히 다양한 수종입니다</div><p>탑핑거 무절뿐 아니라 솔리드에서도 양면유절·양면무절·일면무절이 유통되는 수종입니다. 같은 라디에타파인 안에서 표면과 집성 방식까지 폭넓게 비교할 수 있다는 게 큰 특징입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">솔리드에서도 세 가지 표면 옵션을 고를 수 있습니다</div><p>양면을 모두 보여야 하면 양면무절, 한쪽만 깔끔하면 되는 제작은 일면무절, 자연스러운 옹이를 살리고 싶다면 양면유절을 봅니다. 한 수종 안에서 이렇게 표면 옵션이 나뉘는 건 라디에타파인의 큰 장점입니다.</p></div><div class=\"ds-intro-sub\"><div class=\"ds-intro-sub-title\">탑핑거와는 표면 느낌이 확실히 다릅니다</div><p>탑핑거는 짧은 조각이 이어지지만 솔리드는 긴 원목 조각을 폭 방향으로 붙여 결이 길게 보입니다. 같은 라디에타파인이라도 넓은 상판에서는 두 방식의 차이가 꽤 크게 느껴집니다.</p></div></div>\r\n<div class=\"ds-block-title\">규격 정보</div><table class=\"ds-spec-table\"><tbody><tr><th>규격</th><td>1220×2440mm</td></tr><tr><th>두께옵션</th><td>12T / 15T / 18T / 24T / 30T</td></tr><tr><th>표면옵션</th><td>양면유절 / 양면무절 / 일면무절</td></tr><tr><th>집성방식</th><td>솔리드</td></tr></tbody></table>\r\n<div class=\"ds-section-title\">제품 특징 한눈에 보기</div><div class=\"ds-infographic\"><img src=\"https://ecimg.cafe24img.com/pg2383b21973322017/daesan3833/web/prod_detail/infographic/55.png?v=20260714\" alt=\"라디에타파인 솔리드 집성판의 밝은 원목 표면과 양면유절·양면무절·일면무절 옵션, 솔리드 집성 구조를 설명한 인포그래픽\" style=\"max-width:100%;width:100%;height:auto;display:block;margin:0\" /></div>\r\n<div class=\"ds-block-title\">구매 전 체크포인트</div><div class=\"ds-reason\"><p>• 한 면만 노출되는 제작이라면 일면무절도 같이 비교해 보세요.</p><p>• 유절 제품은 옹이 위치와 크기가 판마다 다릅니다.</p></div>\r\n<div class=\"ds-block-title\">자주 묻는 질문</div><div class=\"ds-faq\"><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 라디에타파인 솔리드는 어떤 분께 잘 맞나요?</p><p class=\"ds-faq-a\">밝은 파인계열 색에 긴 결을 살리면서, 유절·무절까지 실제 노출면에 맞춰 고르고 싶은 분께 잘 맞습니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 일면무절은 언제 고르면 되나요?</p><p class=\"ds-faq-a\">한쪽 면만 외부로 보이고 반대쪽은 가려지는 가구나 제작물이라면 같이 비교해 볼 만합니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 탑핑거와 뭐가 가장 다른가요?</p><p class=\"ds-faq-a\">솔리드는 긴 원목 조각이 이어져 결이 길게 보이고, 탑핑거는 짧은 조각의 이음이 표면에 나타납니다.</p></div><div class=\"ds-faq-item\"><p class=\"ds-faq-q\">Q. 유절과 무절 중 어느 쪽이 더 자연스러운가요?</p><p class=\"ds-faq-a\">옹이가 그대로 보이는 유절 쪽이 원목의 자연스러운 느낌은 더 강합니다.</p></div></div>\r\n\r\n<a class=\"ds-cta\" href=\"https://web-cadalog-ver10.vercel.app/\" target=\"_blank\" rel=\"noopener noreferrer\">대량구매 견적 · 규격 확인하기 →</a>\r\n\r\n<div class=\"ds-phone\">전화 031-388-3833 · 평일 09:00–18:00</div>\r\n\r\n<div class=\"ds-footer\">(주)대산 · 35년 신뢰의 건축자재 전문 공급사</div>\r\n\r\n</div></div></body></html>","additional":[],"unconfirmed":false}